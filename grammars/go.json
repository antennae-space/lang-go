{
  "id": "go",
  "name": "Go",
  "extensions": [
    ".go"
  ],
  "detect": "^package\\s+\\w+",
  "states": {
    "root": [
      {
        "token": "comment",
        "regex": "//.*"
      },
      {
        "token": "comment",
        "regex": "/\\*",
        "next": "comment"
      },
      {
        "token": "string",
        "regex": "`",
        "next": "raw"
      },
      {
        "token": "string",
        "regex": "\"(?:[^\"\\\\]|\\\\.)*\"?|'(?:[^'\\\\]|\\\\.)*'?"
      },
      {
        "token": "number",
        "regex": "\\b(?:0[xX][\\da-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[nfFlLuU]?)\\b|\\.\\d+\\b"
      },
      {
        "token": "keyword",
        "regex": "\\b(?:break|case|chan|const|continue|default|defer|else|fallthrough|for|func|go|goto|if|import|interface|map|package|range|return|select|struct|switch|type|var)\\b"
      },
      {
        "token": "type",
        "regex": "\\b(?:bool|byte|complex64|complex128|error|float32|float64|int|int8|int16|int32|int64|rune|string|uint|uint8|uint16|uint32|uint64|uintptr|any|comparable)\\b"
      },
      {
        "token": "constant",
        "regex": "\\b(?:true|false|iota|nil)\\b"
      },
      {
        "token": "builtin",
        "regex": "\\b(?:append|cap|clear|close|complex|copy|delete|imag|len|make|max|min|new|panic|print|println|real|recover)\\b(?=\\s*\\()"
      },
      {
        "token": "function",
        "regex": "(?<=\\bfunc\\s+(?:\\([^)]*\\)\\s*)?)[A-Za-z_]\\w*"
      },
      {
        "token": "function",
        "regex": "[A-Za-z_$][\\w$]*(?=\\s*\\()"
      },
      {
        "token": "type",
        "regex": "(?<=\\btype\\s+)[A-Za-z_]\\w*"
      },
      {
        "token": "property",
        "regex": "(?<=\\.)[A-Za-z_]\\w*"
      },
      {
        "token": "type",
        "regex": "\\b[A-Z][a-z0-9]\\w*\\b"
      },
      {
        "token": "text",
        "regex": "[A-Za-z_]\\w*"
      },
      {
        "token": "operator",
        "regex": ":=|<-|[-+*/%=<>!&|^~?:]+"
      },
      {
        "token": "punctuation",
        "regex": "[{}()\\[\\];,.]"
      }
    ],
    "comment": [
      {
        "token": "comment",
        "regex": "\\*/",
        "next": "@pop"
      },
      {
        "token": "comment",
        "regex": "[^*]+|\\*"
      }
    ],
    "raw": [
      {
        "token": "string",
        "regex": "`",
        "next": "@pop"
      },
      {
        "token": "string",
        "regex": "[^\\`]+"
      }
    ]
  }
}

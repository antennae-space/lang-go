{
  "$schema": "https://raw.githubusercontent.com/antennae-space/plugin-sdk/v1.16.0/plugin.schema.json",
  "id": "lang-go",
  "name": "Go",
  "version": "1.2.0",
  "apiVersion": 1,
  "ide": ">=1.24.0 <2",
  "assets": "https://github.com/antennae-space/lang-go/releases/download/v{version}/lang-go-{arch}.tar.gz",
  "permissions": [
    "program:gopls",
    "path:GOROOT",
    "path:GOMODCACHE",
    "debugger:go"
  ],
  "contributes": {
    "languages": [
      {
        "id": "go",
        "name": "Go",
        "extensions": [
          ".go"
        ],
        "markers": [
          "go.mod",
          "go.work"
        ],
        "grammar": "grammars/go.json",
        "servers": [
          {
            "argv": [
              "gopls"
            ],
            "paths": [
              {
                "name": "GOROOT",
                "candidates": [
                  "$GOROOT",
                  "@go/../..",
                  "/usr/local/go",
                  "/usr/lib/go",
                  "~/sdk/go"
                ],
                "env": true
              },
              {
                "name": "GOMODCACHE",
                "candidates": [
                  "$GOMODCACHE",
                  "$GOPATH/pkg/mod",
                  "~/go/pkg/mod"
                ],
                "env": true
              }
            ],
            "pathDirs": [
              "GOROOT/bin"
            ],
            "env": {
              "GOTOOLCHAIN": "local",
              "GOPROXY": "off"
            },
            "install": {
              "manager": "go",
              "packages": [
                "golang.org/x/tools/gopls@latest"
              ]
            }
          }
        ],
        "tests": {
          ".go": "{name}_test.go"
        }
      }
    ],
    "debuggers": [
      {
        "type": "go",
        "label": "Go (Delve)",
        "languages": [
          "go"
        ],
        "argv": [
          "dlv",
          "dap",
          "--listen",
          "127.0.0.1:{port}"
        ],
        "transport": "tcp",
        "paths": [
          {
            "name": "GOROOT",
            "candidates": [
              "$GOROOT",
              "@go/../..",
              "/usr/local/go",
              "/usr/lib/go",
              "~/sdk/go"
            ],
            "env": true
          }
        ],
        "pathDirs": [
          "GOROOT/bin"
        ],
        "install": {
          "manager": "go",
          "packages": [
            "github.com/go-delve/delve/cmd/dlv@latest"
          ]
        },
        "templates": [
          {
            "label": "Launch the package",
            "request": "launch",
            "config": {
              "program": "${workspaceFolder}"
            }
          },
          {
            "label": "Test the package",
            "request": "launch",
            "config": {
              "program": "${workspaceFolder}",
              "mode": "test"
            }
          },
          {
            "label": "Attach to a process",
            "request": "attach",
            "config": {
              "processId": "${env:PID}"
            }
          }
        ]
      }
    ]
  }
}
